# ===== Nexova API — Environment Variables =====
# Copy this file to .env and fill in your values.

# JWT secret key (REQUIRED — generate with: openssl rand -hex 32)
NEXOVA_SECRET_KEY=your-secret-key-here-change-in-production

# Token expiration in minutes (default: 60)
NEXOVA_ACCESS_TOKEN_EXPIRE_MINUTES=60

# TinyDB path (relative to services/backend/)
NEXOVA_TINYDB_PATH=data/nexova_db.json

# Resend API key (required for password reset email)
# Get yours at https://resend.com
RESEND_API_KEY=re_xxxxx

# Sender email/name for password reset emails
RESEND_FROM_EMAIL=noreply@nexova.com
RESEND_FROM_NAME=Nexova Talent Pipeline