# Nexova API — Secret configuration
# Generate a strong key with: openssl rand -hex 32
NEXOVA_SECRET_KEY=changeme-in-production-please-use-a-strong-random-key-32chars

# Token expiration in minutes
NEXOVA_ACCESS_TOKEN_EXPIRE_MINUTES=60

# TinyDB path (relative to services/backend/)
NEXOVA_TINYDB_PATH=data/nexova_db.json