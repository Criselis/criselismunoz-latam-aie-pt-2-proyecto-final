# ============================================
# Nexova — Variables de entorno del monorepo (docker compose)
# ============================================
# Copia este archivo a .env en la raíz y completa los valores:
#   cp .env.example .env
# docker-compose.yml lo carga en los servicios backend y uis.

# ----- Frontends (servicio uis) -----
# Ruta que usa el navegador para llamar a la API (mismo origen; Next la reenvía).
NEXT_PUBLIC_API_BASE=/backend-api
# Destino interno del proxy de Next: el backend por NOMBRE DE SERVICIO en la red Docker.
API_INTERNAL_URL=http://backend:8000

# ----- Backend (servicio backend) -----
# Secreto JWT (OBLIGATORIO). Genera uno con: openssl rand -hex 32
NEXOVA_SECRET_KEY=change-me
NEXOVA_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Ruta de TinyDB (relativa a services/backend/)
NEXOVA_TINYDB_PATH=data/nexova_db.json
# PostgreSQL de Supabase (OBLIGATORIO)
SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/postgres
# Email de restablecimiento de contraseña (Resend)
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=noreply@nexova.com
RESEND_FROM_NAME=Nexova Talent Pipeline
# URL pública del frontend que aparece en los enlaces de los emails
NEXOVA_FRONTEND_URL=http://localhost:3001
